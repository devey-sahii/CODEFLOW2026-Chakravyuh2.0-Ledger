{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/index.py"
    },
    {
      "source": "/docs",
      "destination": "/backend/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/backend/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/backend/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
